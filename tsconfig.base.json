{
  // The language settings shared by the map's compile (tsconfig.json: one Lua
  // bundle) and the Lua tests' compile (tests/lua/tsconfig.json: one module
  // per file for the harness). No bundle options here: typescript-to-lua
  // merges `tstl` through `extends`, and a bundle option cannot be unset.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["@typescript-to-lua/language-extensions", "reforged-types/3.0.0"],
    // For editors only: the hover and go to definition of a Rawcode literal,
    // read from the one map folder under maps/. tsc, typescript-to-lua and
    // ESLint ignore it, so it changes no build, lint or test.
    "plugins": [{ "name": "reforged-map/typescript-plugin" }]
  },
  "tstl": {
    "luaTarget": "5.3",
    "noHeader": true,
    "noImplicitSelf": true,
    "sourceMapTraceback": false
  }
}
