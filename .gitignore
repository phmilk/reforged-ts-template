node_modules/

# Output folder: the staged map folder, the Lua bundle and the packed archive.
dist/

# The Lua tests compiled for the harness (pnpm test).
dist-test/

*.tsbuildinfo
*.log

# Written by the pipeline (install, build, watch); regenerated, never committed.
src/generated/

# pnpm use:local: the tarballs packed from a local reforged-ts checkout and
# the list the pnpm hook (.pnpmfile.cjs) reads. `pnpm use:local --reset` removes it.
.local-packages/
